{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KoalaTalk",
  "version": "0.1.0",
  "identifier": "com.koalatalk.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "KoalaTalk",
        "width": 825,
        "height": 650,
        "minWidth": 825,
        "maxWidth": 825,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "App Solution (앱솔루션)",
    "homepage": "https://app-solution.co.kr/",
    "copyright": "Copyright © App Solution",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": ["ko-KR"]
      },
      "nsis": {
        "languages": ["Korean"]
      }
    }
  }
}
